{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(open:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)"
    ]
  }
}
