{
  "folders": [
    {
      "name": "🎬 Video Guide Widget v1.7",
      "path": "."
    }
  ],
  "settings": {
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/*.log": true,
      "**/.vscode-server": true
    },
    "search.exclude": {
      "**/.git": true,
      "**/.vscode-server": true,
      "**/node_modules": true
    },
    "git.enabled": false
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code"
    ]
  }
}
